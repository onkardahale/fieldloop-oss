# Sample systemd unit for the Fieldloop sidecar agent.
#
# Type=simple: the binary runs its own sync loop in the foreground (it does not
# fork or signal readiness), so systemd treats the process being alive as the
# service being up. The agent is crash-safe between passes — its progress lives in
# a persisted manifest — so Restart=always can hard-kill and restart it at any
# moment without losing or duplicating an upload.
#
# Install:
#   cargo build --release -p fieldloop-agent
#   sudo cp target/release/fieldloop-agent /usr/local/bin/
#   sudo cp crates/fieldloop-agent/fieldloop-agent.service /etc/systemd/system/
#   sudo systemctl enable --now fieldloop-agent

[Unit]
Description=Fieldloop sidecar agent (store-and-forward upload of recorded files)
After=network.target

[Service]
Type=simple
# Args: <data-dir> <state-dir>. The data dir is the recorder's output; the state
# dir holds the persisted manifest that makes restarts safe.
ExecStart=/usr/local/bin/fieldloop-agent /var/lib/fieldloop/recordings /var/lib/fieldloop/agent
# Always come back: the agent is designed to be restart-safe, so an unexpected
# exit (or a reboot) just resumes from the manifest on the next start.
Restart=always
RestartSec=5
# Run unprivileged with a minimal filesystem footprint; it only needs to read the
# recordings and read/write its own state dir.
DynamicUser=yes
StateDirectory=fieldloop/agent

[Install]
WantedBy=multi-user.target
